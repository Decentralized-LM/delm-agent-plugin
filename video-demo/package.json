{
  "name": "delm-video-demo",
  "version": "0.1.0",
  "private": true,
  "description": "DeLM for Claude Code and Codex product film",
  "type": "module",
  "scripts": {
    "preview": "node scripts/hyperframes.mjs preview --no-open",
    "render": "node scripts/hyperframes.mjs render --fps 60 --quality delivery --crf 12 --resolution 4k --workers 4 --output renders/delm-demo.mp4",
    "lint": "node scripts/hyperframes.mjs lint",
    "review": "node scripts/review.mjs",
    "build": "node scripts/build.mjs",
    "prepreview": "npm run build",
    "prerender": "npm run build",
    "prelint": "npm run build",
    "capture": "node scripts/capture-game.mjs",
    "presound": "npm run build",
    "sound": "python3 scripts/mix-sound.py --music assets/audio/clean-desk.mp3",
    "edit-footage": "node scripts/capture-game.mjs --edit-only"
  },
  "devDependencies": {
    "gsap": "3.15.0",
    "hyperframes": "0.8.114",
    "playwright": "1.63.0"
  }
}
